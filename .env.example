OPENAI_API_KEY=sk-proj_your_openai_api_key
GEMINI_API_KEY=your_gemini_api_key
LOVABLE_API_KEY=your_lovable_ai_gateway_key

# Optional model overrides
OPENAI_MODEL=gpt-4o-mini
GEMINI_MODEL=gemini-2.5-flash
OPENAI_IMAGE_MODEL=gpt-image-1
LOVABLE_OPENAI_IMAGE_MODEL=openai/gpt-image-2
LOVABLE_GEMINI_IMAGE_MODEL=google/gemini-2.5-flash-image
ENABLE_OPENAI_DIRECT_FALLBACK=false
